FROM python:3.9-slim

WORKDIR /app

# Copy the simulator script
COPY docker/simulate_logs.py /app/

# Make the script executable
RUN chmod +x /app/simulate_logs.py

# Create a startup script
RUN echo '#!/bin/bash\npython /app/simulate_logs.py $RSYSLOG_HOST $RSYSLOG_PORT' > /app/start.sh && \
    chmod +x /app/start.sh

# Run the simulator
CMD ["/app/start.sh"] 